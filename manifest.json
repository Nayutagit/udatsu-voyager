{
    "name": "Udatsu Voyager",
    "short_name": "Voyager",
    "start_url": "./index.php",
    "display": "standalone",
    "background_color": "#1a1a1a",
    "theme_color": "#00ffcc",
    "description": "Voice & Thought Assets",
    "icons": [
        {
            "src": "img/favicon.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "img/udatsu-logo.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "share_target": {
        "action": "./share_upload.php",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "files": [
                {
                    "name": "audioFile",
                    "accept": ["audio/*", ".m4a", ".mp3", ".wav", ".aac"]
                }
            ]
        }
    }
}