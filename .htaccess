##############################
# 1. いつでも有効：HTTPS 強制
##############################
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

###########################################################
# 2. メンテナンスモード（使う時だけ ON）
#    手順:
#      A) maintenance.html をルートにアップ
#      B) 次の 4 行の先頭 # を外して保存
#      C) 解除するときは # を戻す or maintenance.html を削除
###########################################################
#RewriteCond %{REQUEST_URI} !^/maintenance\.html$
#RewriteCond %{REQUEST_URI} !^/img/.*$
#RewriteCond %{REQUEST_URI} !^/favicon\.ico$
#RewriteRule ^.*$ /maintenance.html [R=302,L]
# Udatsu 公開講座（既存の他のURLは維持）
RewriteRule ^(?:api/(?:catalog|slots|checkout|stripe/webhook|bookings/[a-f0-9]{40}|demo/pay|admin/(?:overview|slots|close|retry))|admin|styles\.css|app\.js|admin\.js|instructor\.png)$ index.php [L]
